      "seed": 839593305,
      "version": 95,
      "versionNonce": 576447511,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787485355890,
      "link": null,
      "locked": false,
      "text": "Exhaustive Grid Search was utilized for baseline and proximity-based models due to their\nlow-dimensional hyperparameter spaces, ensuring global optima identification. Conversely, the\ncomputationally expensive ensemble model (Isolation Forest) was tuned via Bayesian\nOptimization to efficiently navigate its high-dimensional space.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Exhaustive Grid Search was utilized for baseline and proximity-based models due to their low-dimensional hyperparameter spaces, ensuring global optima identification. Conversely, the computationally expensive ensemble model (Isolation Forest) was tuned via Bayesian Optimization to efficiently navigate its high-dimensional space.",
      "autoResize": false,
      "lineHeight": 1.25
    },
